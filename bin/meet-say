#!/usr/bin/env python3
"""Speak, murmur, pass the baton or share a screen in a meetdown meeting from an AI pane.
Usage: meet-say "what to say"                      speak (normal voice, big balloon)
       meet-say --murmur "short remark"            murmur (half volume, small balloon; held while the human talks)
       meet-say --pass <name> "what to say"        speak and hand the baton to <name>
       meet-say --share <path-or-url> ["caption"]  show a file (html, pdf, png, jpg, svg) or a URL to everyone
       meet-say --scroll <0-100>                   scroll the shared page
       meet-say --unshare                          stop sharing
The speaker is identified by $TMUX_PANE; panes that are not participants are refused."""
import json, os, sys, urllib.error, urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
cfg = json.load(open(os.path.join(ROOT, "config.json"), encoding="utf-8"))
token = open(os.path.join(ROOT, ".token"), encoding="utf-8").read().strip()
pane = os.environ.get("TMUX_PANE", "")


def post(route, body):
    req = urllib.request.Request(f"http://127.0.0.1:{cfg['port']}{route}", json.dumps({"pane": pane, **body}).encode(),
                                 {"Content-Type": "application/json", "X-Token": token})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            print("meet-say: " + json.load(r).get("note", "sent"))
    except urllib.error.HTTPError as e:
        sys.exit("meet-say: " + e.read().decode("utf-8", "replace"))
    except OSError as e:
        sys.exit(f"meet-say: cannot reach the meetdown server ({e})")


args = sys.argv[1:]
if args[:1] == ["--share"] and len(args) >= 2:
    target = args[1]
    body = {"url": target} if target.startswith(("http://", "https://")) else {"path": os.path.abspath(os.path.expanduser(target))}
    post("/api/share", {**body, "caption": " ".join(args[2:])})
elif args[:1] == ["--unshare"]:
    post("/api/share", {"stop": True})
elif args[:1] == ["--scroll"] and len(args) == 2:
    post("/api/share", {"scroll": float(args[1])})
else:
    kind, pass_to = "speech", None
    if args[:1] == ["--murmur"]:
        kind, args = "murmur", args[1:]
    elif len(args) >= 2 and args[0] == "--pass":
        pass_to, args = args[1], args[2:]
    text = " ".join(args).strip() or ("" if sys.stdin.isatty() else sys.stdin.read().strip())
    if not text:
        sys.exit("meet-say: nothing to say")
    post("/api/say", {"text": text, "kind": kind, "pass": pass_to})
