#!/usr/bin/env python3
"""Speak a reply in a meetdown meeting from an AI pane.
Usage: meet-say "what to say"
       meet-say --pass <name> "what to say"   (chair only: hand the floor to <name>)
The speaker is identified by $TMUX_PANE; panes that are not participants are refused."""
import json, os, sys, urllib.error, urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
args = sys.argv[1:]
pass_to = None
if len(args) >= 2 and args[0] == "--pass":
    pass_to, args = args[1], args[2:]
text = " ".join(args).strip() or ("" if sys.stdin.isatty() else sys.stdin.read().strip())
if not text:
    sys.exit("meet-say: nothing to say")

cfg = json.load(open(os.path.join(ROOT, "config.json"), encoding="utf-8"))
token = open(os.path.join(ROOT, ".token"), encoding="utf-8").read().strip()
body = json.dumps({"pane": os.environ.get("TMUX_PANE", ""), "text": text, "pass": pass_to}).encode()
req = urllib.request.Request(f"http://127.0.0.1:{cfg['port']}/api/say", body, {"Content-Type": "application/json", "X-Token": token})
try:
    with urllib.request.urlopen(req, timeout=10) as r:
        print("meet-say: " + json.load(r).get("note", "sent"))
except urllib.error.HTTPError as e:
    sys.exit("meet-say: " + e.read().decode("utf-8", "replace"))
except OSError as e:
    sys.exit(f"meet-say: cannot reach the meetdown server ({e})")
